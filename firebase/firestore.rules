rules_version = '2';
// Kulis güvenlik kuralları
// Temel ilke: herkes sadece kendi adına yazar; gizli bilgiler sadece sahibine, mesajlar sadece sohbetin iki tarafına görünür.
// Sayaçlar (tepki, yorum) ancak gerçek bir tepki/yorumla birlikte değişebilir. Yazma işlemleri hız sınırına tabidir.
service cloud.firestore {
  match /databases/{database}/documents {

    // giriş yapmış VE e-postası doğrulanmış (Google ya da e-posta bağlantısı); misafir hesaplar hiçbir şey yapamaz
    // banlanan hesap (bans/{uid}) hiçbir şey okuyamaz ve yazamaz
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true
      && !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }
    // moderatörler: config/mods.uids listesindekiler (yönetici de moderatör sayılır)
    function isMod() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/config/mods)
        && request.auth.uid in get(/databases/$(database)/documents/config/mods).data.uids);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Premium: satın alma doğrulamasının yazdığı users/{uid}/private/premium belgesi (sunucu yazar, kullanıcı yazamaz).
    // Yönetici/moderatör ve Google Play inceleme hesabında her şey açık.
    function premPath() { return /databases/$(database)/documents/users/$(request.auth.uid)/private/premium; }
    function staffOrReviewer() { return request.auth.token.get('email', '') == 'kulistrinfo@gmail.com' || isMod(); }
    // Açılış dönemi: config/genel.acilis true iken herkes Kulis Tam gibi (yönetici panelinden açılıp kapanır)
    function acilisAcik() {
      return exists(/databases/$(database)/documents/config/genel)
        && get(/databases/$(database)/documents/config/genel).data.get('acilis', false) == true;
    }
    function premOk() {
      return acilisAcik() || (exists(premPath()) && get(premPath()).data.get('active', false) == true
              && get(premPath()).data.get('until', 0) > request.time.toMillis())
        || staffOrReviewer();
    }
    // paket: sohbet < ses (sesli arama) < tam (görüntülü arama dahil)
    function tierOk(need) {
      return acilisAcik() || (exists(premPath()) && get(premPath()).data.get('active', false) == true
              && get(premPath()).data.get('until', 0) > request.time.toMillis()
              && (need == 'sohbet' || get(premPath()).data.get('tier', 'tam') in (need == 'ses' ? ['ses','tam'] : ['tam'])))
        || staffOrReviewer();
    }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    // Yüklenen dosyalar sadece Kulis'in kendi depolama alanından gelebilir
    function stUrl(v, dir) {
      return v is string && v.size() < 600
        && v.matches('https://firebasestorage[.]googleapis[.]com/v0/b/kulis-1647d[.]firebasestorage[.]app/o/' + dir + '%2F' + request.auth.uid + '%2F[^/?#]+[?]alt=media&token=[0-9a-f-]+');
    }
    // herkese açık profil görseli: boş ya da hazır görsel. Gerçek fotoğraflar perde arkasında (gizli/foto)
    function img(v) { return v == null || (v is string && v.matches('preset:[a-z0-9]{1,8}')); }

    // ---- Hız sınırı: her kullanıcının users/{uid}/meta/rl belgesinde son yazma zamanları durur.
    // Bir itiraf/yorum/mesaj yazılırken aynı işlemde ilgili alan "şimdi" yapılmak zorunda; kural bir öncekiyle arada süre arar.
    function rlPath() { return /databases/$(database)/documents/users/$(request.auth.uid)/meta/rl; }
    function stamped(k) { return existsAfter(rlPath()) && getAfter(rlPath()).data.get(k, null) == request.time; }

    // ---- Küfür / yasaklı kelime filtresi: yönetici panelinden yönetilen config/moderation.re
    function modPath() { return /databases/$(database)/documents/config/moderation; }
    function clean(t) {
      return !exists(modPath()) || get(modPath()).data.get('re', '') == ''
        || !t.lower().matches('(?s).*' + get(modPath()).data.re + '.*');
    }
    function blockedBy(other) { return exists(/databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid)); }

    // Ayarlar: yönetici listesi sadece Firebase panelinden; yasaklı kelimeler yönetici panelinden
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if (doc == 'genel' && isAdmin()
          && request.resource.data.keys().hasOnly(['acilis','acilisBas','updatedAt'])
          && request.resource.data.acilis is bool)
        || (doc == 'moderation' && isAdmin()
        && request.resource.data.keys().hasOnly(['re','words','updatedAt'])
        && request.resource.data.re is string && request.resource.data.re.size() < 20000)
        || (doc == 'mods' && isAdmin() && request.resource.data.keys().hasOnly(['uids','updatedAt'])
            && request.resource.data.uids is list && request.resource.data.uids.size() <= 50);
    }

    // Herkese açık profil (takma ad, burç, yaş aralığı, cinsiyet, renk, görseller)
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['n','c','s','g','age','bio','av','banner','guest','createdAt','lastSeen'])
        && str(request.resource.data.n, 3, 20) && clean(request.resource.data.n)
        && request.resource.data.g in ['Kadın','Erkek']
        && request.resource.data.createdAt == request.time;
      // burç ve yaş aralığı sonradan değiştirilemez; cinsiyet sadece "Belirtmeyeyim"den bir kez seçilebilir
      allow update: if isMe(uid)
        && changed().hasOnly(['n','c','bio','av','banner','lastSeen','g'])
        && (!('g' in changed()) || (resource.data.g == 'Belirtmeyeyim' && request.resource.data.g in ['Kadın','Erkek']))
        && (!('n' in changed()) || (str(request.resource.data.n, 3, 20) && clean(request.resource.data.n)))
        && (!('bio' in changed()) || (str(request.resource.data.bio, 0, 120) && clean(request.resource.data.bio)))
        && (!('av' in changed()) || img(request.resource.data.av))
        && (!('banner' in changed()) || img(request.resource.data.banner));
      // doğrulanmış profil rozeti (dg): sadece moderatör/yönetici verir ya da kaldırır
      allow update: if isMod() && changed().hasOnly(['dg']) && request.resource.data.dg is bool;
      allow delete: if isMe(uid) || isAdmin();

      // Gizli bilgiler: gerçek ad, e-posta, doğum tarihi. Sahibi ve yönetici görür.
      // premium belgesini sadece ödeme doğrulama fonksiyonu yazar
      match /private/{doc} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid) && doc == 'info';
        allow update: if false;
        allow delete: if (isMe(uid) && doc == 'info') || isAdmin();
      }
      // Perde arkası: gerçek fotoğraf ve kapağın depodaki yolu. Sadece sahibi görür; perdesi açık olanlara sunucu verir.
      match /gizli/{d} {
        function rp(v) { return v == null || (v is string && v.matches('r/' + uid + '/[A-Za-z0-9._-]{1,60}')); }
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && d == 'foto'
          && request.resource.data.keys().hasOnly(['av','banner','ts'])
          && rp(request.resource.data.get('av', null)) && rp(request.resource.data.get('banner', null));
        allow delete: if isMe(uid) || isAdmin();
      }
      // Profil ziyaretleri: ziyaretçi kendi adına iz bırakır (belge kimliği = ziyaretçi, içerik sadece zaman). Sahibi okur ve siler.
      match /ziyaret/{vid} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(vid) && vid != uid && !blockedBy(uid)
          && request.resource.data.keys().hasOnly(['ts']) && request.resource.data.ts == request.time;
      }
      // Anonim sorular: sadece sunucu (anonimSoru) yazar. Sahibi okur, cevaplandı diye işaretler, siler.
      match /sorular/{sid} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid) && changed().hasOnly(['cevap','pid'])
          && request.resource.data.cevap == true && str(request.resource.data.pid, 10, 40);
      }
      // Hız sınırı belgesi: her alan sadece "şimdi" yapılabilir ve bir öncekinden belli süre sonra
      match /meta/{d} {
        function tick(k, secs) {
          return !(k in request.resource.data)
            || (resource != null && k in resource.data && request.resource.data[k] == resource.data[k])
            || (request.resource.data[k] == request.time
                && (resource == null || !(k in resource.data) || request.time > resource.data[k] + duration.value(secs, 's')));
        }
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && d == 'rl'
          && request.resource.data.keys().hasOnly(['postAt','cmAt','ntAt','chAt','msgAt','errAt','callAt'])
          && tick('callAt', 10) && tick('postAt', 900) && tick('cmAt', 8) && tick('ntAt', 2) && tick('chAt', 20) && tick('msgAt', 1) && tick('errAt', 20);
      }
      // Bildirim anahtarları (telefon/tarayıcı): sadece sahibi
      // Ayarlar: telefon bildirimi tercihleri, sessiz saatler, arama izinleri. Arama izinlerini arayan taraf da okuyabilmeli.
      match /settings/{d} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && d == 'main'
          && request.resource.data.keys().hasOnly(['n','quiet','qFrom','qTo','callVoice','callVideo','dm','okundu','yaziyor','songor','seo','iz','soru','updatedAt'])
          && (!('seo' in request.resource.data) || request.resource.data.seo is bool)
          && (!('songor' in request.resource.data) || request.resource.data.songor is bool)
          && (!('iz' in request.resource.data) || request.resource.data.iz is bool)
          && (!('soru' in request.resource.data) || request.resource.data.soru is bool)
          && (!('dm' in request.resource.data) || request.resource.data.dm in ['herkes','eslesme','kimse'])
          && (!('okundu' in request.resource.data) || request.resource.data.okundu is bool)
          && (!('yaziyor' in request.resource.data) || request.resource.data.yaziyor is bool)
          && (!('n' in request.resource.data) || request.resource.data.n is map)
          && (!('qFrom' in request.resource.data) || (request.resource.data.qFrom is int && request.resource.data.qFrom >= 0 && request.resource.data.qFrom < 24))
          && (!('qTo' in request.resource.data) || (request.resource.data.qTo is int && request.resource.data.qTo >= 0 && request.resource.data.qTo < 24));
        allow delete: if isMe(uid) || isAdmin();
      }
      match /push/{token} {
        allow read, write: if isMe(uid);
      }
      // Kendi anonim itiraflarının listesi: sunucu yazar, sahibi okur
      match /anon/{pid} {
        allow read: if isMe(uid);
        allow delete: if isMe(uid);
      }
      // Kaydedilen itiraflar: sadece sahibi
      match /kayit/{pid} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['ts']) && request.resource.data.ts == request.time;
      }
      // Engellenenler: sadece sahibi
      match /blocks/{other} {
        allow read, write: if isMe(uid);
      }
      // Bildirimler: sahibi okur ve siler; başkası sadece kendi adına, hız sınırıyla bildirim bırakabilir
      match /notifs/{nid} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid) && changed().hasOnly(['read']);
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['from','type','text','go','ts','read'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['cm','react','req','dm','match','like','call','perde']
          && str(request.resource.data.text, 1, 200) && request.resource.data.ts == request.time
          && !blockedBy(uid) && stamped('ntAt');
      }
    }

    // Perde: iki kişi karşılıklı onaylayınca birbirinin gerçek fotoğrafını görür. Belge kimliği sohbet kimliğiyle aynı.
    match /perde/{pid} {
      function pm() { return request.resource.data.members; }
      function otherOf(l) { return l[0] == request.auth.uid ? l[1] : l[0]; }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members','by','status','ts'])
        && pm() is list && pm().size() == 2 && pm()[0] is string && pm()[1] is string && pm()[0] < pm()[1]
        && pid == pm()[0] + '_' + pm()[1]
        && request.auth.uid in pm() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'istek' && request.resource.data.ts == request.time
        && exists(/databases/$(database)/documents/chats/$(pid))
        && get(/databases/$(database)/documents/chats/$(pid)).data.status == 'open'
        && !blockedBy(otherOf(pm()));
      // isteği sadece karşı taraf kabul eder
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && resource.data.status == 'istek' && resource.data.by != request.auth.uid
        && changed().hasOnly(['status','ts'])
        && request.resource.data.status == 'acik' && request.resource.data.ts == request.time;
      // iki taraftan biri istediği an perdeyi kapatır (ya da isteği reddeder)
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Kulis Ekibi yazışması: yönetici/moderatör kullanıcıya yazar, kullanıcı sadece ekibin açtığı yazışmaya cevap verir
    match /ekip/{uid} {
      function thr() { return request.resource.data; }
      function thrOk() {
        return thr().keys().hasOnly(['uid','last','lastAt','lastBy','lastStaff','staffUnread','userUnread'])
          && thr().uid == uid && str(thr().get('last', ''), 0, 120);
      }
      allow read: if isMe(uid) || isMod();
      allow create: if isMod() && thrOk() && thr().lastBy == request.auth.uid && thr().lastStaff == true;
      allow update: if thrOk() && (
          (isMod() && (!('lastBy' in changed()) || thr().lastBy == request.auth.uid))
          || (isMe(uid) && (!('lastBy' in changed()) || thr().lastBy == uid) && (!('lastStaff' in changed()) || thr().lastStaff == false)));
      allow delete: if isAdmin();

      match /m/{mid} {
        function msg() { return request.resource.data; }
        allow read: if isMe(uid) || isMod();
        allow create: if msg().keys().hasOnly(['from','staff','role','t','ts']) && msg().ts == request.time
          && str(msg().t, 1, 1000) && (
            (isMod() && msg().from == request.auth.uid && msg().staff == true && (msg().role == 'Moderatör' || (msg().role == 'Yönetici' && isAdmin())))
            || (isMe(uid) && msg().from == uid && msg().staff == false && !('role' in msg())
                && exists(/databases/$(database)/documents/ekip/$(uid)) && clean(msg().t) && stamped('msgAt')));
        allow update, delete: if false;
      }
    }

    // Banlar: sadece sunucu fonksiyonu yazar. Kişi kendi ban kaydını görebilir (giriş yapamaz ama nedenini görür).
    match /bans/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isMod();
      allow write: if false;
    }

    // Takma adlar benzersiz olsun
    match /nicks/{nick} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if false;
    }

    // İtiraflar
    // Günlük seri: kişinin kendi sayacı (hile yapsa bile sadece kendi rozetini etkiler). Akşam hatırlatmasını sunucu okur.
    match /seriler/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['gun','n','en','ts'])
        && request.resource.data.gun is string && request.resource.data.gun.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]')
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5000
        && request.resource.data.en is int && request.resource.data.en >= request.resource.data.n
        && request.resource.data.ts == request.time;
    }
    // Selfie ile doğrulama başvurusu: kişi kendi başvurusunu açar (selfie depoda v/{uid}/...), moderatör onaylar ya da reddeder.
    match /dogrulama/{uid} {
      function basvuru() {
        return request.resource.data.keys().hasOnly(['path','poz','ts','durum'])
          && request.resource.data.durum == 'bekliyor' && request.resource.data.ts == request.time
          && request.resource.data.path is string && request.resource.data.path.matches('v/' + uid + '/[A-Za-z0-9._-]{1,60}')
          && str(request.resource.data.poz, 2, 40);
      }
      allow read: if isMe(uid) || isMod();
      allow create: if isMe(uid) && basvuru();
      allow update: if (isMe(uid) && resource.data.durum != 'bekliyor' && basvuru())
        || (isMod() && changed().hasOnly(['durum','by','sts']) && request.resource.data.durum in ['onay','ret']
            && request.resource.data.by == request.auth.uid && request.resource.data.sts == request.time);
      allow delete: if isMe(uid) || isAdmin();
    }

    match /posts/{pid} {
      function reactPath() { return /databases/$(database)/documents/posts/$(pid)/reactions/$(request.auth.uid); }
      function rBefore() { return exists(reactPath()) ? get(reactPath()).data.k : ''; }
      function rAfter() { return existsAfter(reactPath()) ? getAfter(reactPath()).data.k : ''; }
      // bir tepki sayacı, ancak bu kullanıcının tepki belgesindeki değişiklik kadar oynayabilir
      function rOk(k) {
        return request.resource.data.r[k] - resource.data.r[k] == (rAfter() == k ? 1 : 0) - (rBefore() == k ? 1 : 0);
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','t','cat','q','r','cm','ts','a'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.t, request.resource.data.cat == 'soru' ? 3 : 15, 500) && clean(request.resource.data.t)
        && request.resource.data.cat in ['ask','aile','arkadas','is','okul','kimse','soru']
        && (!('q' in request.resource.data) || (request.resource.data.cat == 'soru' && str(request.resource.data.q, 5, 200)))
        && request.resource.data.r == {'bende': 0, 'saril': 0, 'yok': 0}
        && request.resource.data.cm == 0
        && request.resource.data.ts == request.time
        && stamped('postAt');
      // öne çıkarma sadece moderatör: feat = bitiş zamanı (ms) ya da null
      allow update: if isMod() && changed().hasOnly(['feat'])
        && (request.resource.data.feat == null || request.resource.data.feat is int);
      allow update: if signedIn() && changed().hasOnly(['r','cm'])
        && (!('r' in changed()) || (request.resource.data.r.keys().hasOnly(['bende','saril','yok'])
              && rOk('bende') && rOk('saril') && rOk('yok')))
        && (!('cm' in changed())
              || (request.resource.data.cm == resource.data.cm + 1 && stamped('cmAt'))
              || (request.resource.data.cm == resource.data.cm - 1 && request.resource.data.cm >= 0));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod()
        || (resource.data.get('anon', false) == true
            && get(/databases/$(database)/documents/anonOwners/$(pid)).data.uid == request.auth.uid));

      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && request.resource.data.k in ['bende','saril','yok'];
        allow delete: if isMe(uid);
      }
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.t, 1, 300) && clean(request.resource.data.t)
          && (!('re' in request.resource.data) || (request.resource.data.re is map
                && request.resource.data.re.keys().hasOnly(['id','n']) && str(request.resource.data.re.id, 1, 40) && str(request.resource.data.re.n, 1, 20)))
          && request.resource.data.ts == request.time && stamped('cmAt');
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
        allow update: if false;
      }
    }

    // Şikâyetler: herkes gönderebilir, sadece yönetici görür
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','key','reason','preview','status','ts','target','cid','mids','msgs'])
        && (!('msgs' in request.resource.data) || (request.resource.data.msgs is list && request.resource.data.msgs.size() <= 30))
        && str(request.resource.data.reason, 2, 60) && request.resource.data.ts == request.time
        && request.resource.data.status == 'bekliyor'
        && (!('mids' in request.resource.data) || (request.resource.data.mids is list && request.resource.data.mids.size() <= 20));
      allow read: if isMod();
      allow update: if isMod() && changed().hasOnly(['status','doneBy','doneAt'])
        && request.resource.data.status in ['kaldirildi','yoksayildi','banlandi'];
      allow delete: if isAdmin();
    }

    // Sitedeki hatalar: kullanıcı tarayıcısı yazar (hız sınırıyla), sadece yönetici görür
    match /errors/{eid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','msg','where','ua','v','ts'])
        && str(request.resource.data.msg, 1, 600) && request.resource.data.ts == request.time && stamped('errAt');
      allow read, delete: if isAdmin();
    }

    // Eşleş beğenileri: belge adı "beğenen_beğenilen"
    match /likes/{lid} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && lid == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.ts == request.time;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // Sohbetler: belge adı iki kişinin kimliğinin sıralı birleşimi, sadece iki taraf görür
    // Sesli / görüntülü arama: WebRTC bağlantı bilgileri. Sadece açık sohbeti olanlar, engellenmemişse ve karşı taraf izin veriyorsa.
    match /calls/{id} {
      function inCall() { return signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid); }
      function setPath(u) { return /databases/$(database)/documents/users/$(u)/settings/main; }
      function allows(u, t) { return !exists(setPath(u)) || get(setPath(u)).data.get(t == 'video' ? 'callVideo' : 'callVoice', true) != false; }
      function chatPath(a, b) { return /databases/$(database)/documents/chats/$(a < b ? a + '_' + b : b + '_' + a); }
      allow read: if inCall();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from','to','members','type','status','offer','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.members == [request.auth.uid, request.resource.data.to]
        && request.resource.data.type in ['voice','video'] && request.resource.data.status == 'ring'
        && request.resource.data.offer is map && request.resource.data.ts == request.time
        && tierOk(request.resource.data.type == 'video' ? 'tam' : 'ses')
        && exists(chatPath(request.auth.uid, request.resource.data.to))
        && get(chatPath(request.auth.uid, request.resource.data.to)).data.status == 'open'
        && !blockedBy(request.resource.data.to)
        && allows(request.resource.data.to, request.resource.data.type)
        && stamped('callAt');
      allow update: if inCall()
        && changed().hasOnly(['status','answer'])
        && request.resource.data.status in ['ring','accept','decline','end','miss']
        && (!('answer' in changed()) || resource.data.to == request.auth.uid)
        && (!(request.resource.data.status in ['accept','decline']) || resource.data.to == request.auth.uid || request.resource.data.status == resource.data.status)
        && (request.resource.data.status != 'miss' || resource.data.from == request.auth.uid);
      allow delete: if false;
      match /{side}/{cid} {
        function call() { return get(/databases/$(database)/documents/calls/$(id)).data; }
        allow read: if signedIn() && request.auth.uid in call().members;
        allow create: if signedIn()
          && ((side == 'fc' && call().from == request.auth.uid) || (side == 'tc' && call().to == request.auth.uid))
          && request.resource.data.keys().hasOnly(['c']) && str(request.resource.data.c, 2, 2000);
      }
    }

    // Günlük huni sayaçları (sadece sayı): sunucu yazar, yönetici okur
    // Gönderilen duyuruların geçmişi: sunucu yazar, yönetici okur
    match /duyurular/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /istatistik/{gun} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /chats/{cid} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      function other(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
      // karşı tarafın "kimler bana yazabilir" ayarı: herkes (varsayılan) / eslesme / kimse
      function dmMode(u) { return exists(/databases/$(database)/documents/users/$(u)/settings/main)
        ? get(/databases/$(database)/documents/users/$(u)/settings/main).data.get('dm', 'herkes') : 'herkes'; }
      // yazıyor / görüldü: herkes sadece kendi alanını değiştirebilir, değer sayı (ms)
      function ownMap(k) { return !(k in changed())
        || (request.resource.data[k] is map
            && request.resource.data[k].diff(resource.data.get(k, {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data[k][request.auth.uid] is int); }
      allow read: if member();
      allow create: if signedIn()
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && cid == (request.resource.data.members[0] < request.resource.data.members[1]
              ? request.resource.data.members[0] + '_' + request.resource.data.members[1]
              : request.resource.data.members[1] + '_' + request.resource.data.members[0])
        && request.resource.data.reqBy == request.auth.uid
        && !blockedBy(other(request.resource.data.members))
        && ((request.resource.data.status == 'wait' && stamped('chAt') && dmMode(other(request.resource.data.members)) == 'herkes')
            // eşleşme: iki taraf da birbirini beğendiyse sohbet direkt açık başlar
            || (request.resource.data.status == 'open' && request.resource.data.match == true
                && dmMode(other(request.resource.data.members)) != 'kimse'
                && exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + other(request.resource.data.members)))
                && exists(/databases/$(database)/documents/likes/$(other(request.resource.data.members) + '_' + request.auth.uid))));
      // isteği sadece karşı taraf kabul edebilir
      allow update: if member()
        && changed().hasOnly(['status','last','lastAt','lastBy','seen','ty','n'])
        && ownMap('seen') && ownMap('ty')
        && (!('n' in changed()) || request.resource.data.n == resource.data.get('n', 0) + 1)
        && (!('status' in changed()) || (request.resource.data.status == 'open' && resource.data.reqBy != request.auth.uid));
      allow delete: if member();

      match /messages/{mid} {
        function chatAfter() { return getAfter(/databases/$(database)/documents/chats/$(cid)).data; }
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if signedIn() && request.auth.uid in chatAfter().members
          && !blockedBy(other(chatAfter().members))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','t','ts','img','aud','dur','re','g'])
          && (!('g' in request.resource.data) || (request.resource.data.g is string && request.resource.data.g.matches('^[A-Za-z0-9]{4,40}$')))
          && (!('re' in request.resource.data) || (request.resource.data.re is map && request.resource.data.re.keys().hasOnly(['id','t','u'])
                && str(request.resource.data.re.id, 1, 40) && str(request.resource.data.re.t, 0, 120) && request.resource.data.re.u is string))
          && str(request.resource.data.t, 0, 1000) && clean(request.resource.data.t)
          && (request.resource.data.t.size() > 0 || 'img' in request.resource.data || 'aud' in request.resource.data || 'g' in request.resource.data)
          && (!('img' in request.resource.data) || stUrl(request.resource.data.img, 'm'))
          && (!('aud' in request.resource.data) || (stUrl(request.resource.data.aud, 'm')
                && request.resource.data.dur is number && request.resource.data.dur > 0 && request.resource.data.dur <= 120))
          && (!('dur' in request.resource.data) || 'aud' in request.resource.data)
          && request.resource.data.ts == request.time && stamped('msgAt')
          // ücretsiz üyelikte sohbet başına 20 mesaj; sonrası premium
          && chatAfter().get('n', 0) == get(/databases/$(database)/documents/chats/$(cid)).data.get('n', 0) + 1
          && (chatAfter().get('n', 0) <= 20 || premOk());
        // moderatör bildirilen mesajı silebilir: içerik boşaltılır, "moderatör tarafından silindi" işareti kalır
        allow update: if isMod()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t','img','aud','dur','mod','g'])
          && request.resource.data.mod == true && request.resource.data.t == ''
          && !('img' in request.resource.data) && !('aud' in request.resource.data) && !('g' in request.resource.data);
        // emoji tepkisi: sohbetin üyesi, sadece kendi tepkisini (tp.<uid>) koyar ya da kaldırır
        allow update: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members
          && changed().hasOnly(['tp'])
          && request.resource.data.tp is map
          && request.resource.data.tp.diff(resource.data.get('tp', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.tp) || request.resource.data.tp[request.auth.uid] in ['❤️','😂','😮','😢','👍','🔥']);
        allow delete: if false;
      }
    }
  }
}
